{
  "type": "module",
  "name": "@vtaits/react-paginator",
  "version": "3.0.0",
  "description": "Simple customizable pagination component for react applications",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.js",
    "!src/__fixtures__",
    "!src/__stories__",
    "!src/__tests__"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "typings": "dist/ts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./styles.css": {
      "import": "./src/styles.css"
    }
  },
  "keywords": [
    "react",
    "ui",
    "pagination",
    "paginator"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:vtaits/react-paginator.git"
  },
  "author": "Vadim Taits",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:ts": "tsc",
    "test:unit": "vitest run --browser.headless --coverage.enabled --coverage.all --coverage.include=src --coverage.exclude=src/__fixtures__ --coverage.exclude=src/__stories__",
    "test:unit:watch": "vitest",
    "test": "bun run test:unit",
    "prepare": "bun run build"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.6",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
