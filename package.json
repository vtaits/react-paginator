{
  "name": "react-paginator-root",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "bun --filter='*' run build",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "test:unit": "bun --filter='*' run test:unit",
    "test:ts": "bun --filter='*' run test:ts",
    "test": "bun run lint && bun run test:ts && bun run test:unit",
    "validate": "bun run test && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:vtaits/react-paginator.git"
  },
  "author": "Vadim Taits",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/bun": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
